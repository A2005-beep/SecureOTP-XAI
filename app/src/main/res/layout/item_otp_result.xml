<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOtpResult"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/cyber_surface"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp">

    <!-- Horizontal layout to hold the neon left indicator and the card content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Neon Left Border Indicator -->
        <View
            android:id="@+id/viewOtpDivider"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/text_secondary"/>

        <!-- Main Card Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row: Label + Risk Score -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvOtpLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANALYZING..."
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:letterSpacing="0.05"
                        android:background="#1AEF4444"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/tvOtpRiskScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:text="Risk: 0"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="@+id/tvOtpLabel"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Sender -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tvOtpSender"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:text="From: Unknown"/>

                    <TextView
                        android:id="@+id/tvOtpSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:text="Source: Unknown"/>
                </LinearLayout>

                <!-- Message body -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1AFFFFFF"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INTERCEPTED MESSAGE:"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvOtpMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        android:text="Scanning..."/>
                </LinearLayout>

                <!-- Analysis section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analysis:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/tvOtpReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:text="• Waiting for analysis"/>

                <!-- 🧠 AI AGENT INSIGHT SECTION -->
                <LinearLayout
                    android:id="@+id/layoutAiInsight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1A00E5FF"
                    android:padding="12dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvAiInsight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🧠 AI Insight: Analyzing..."
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:lineSpacingExtra="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Confidence: "
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pbAiConfidence"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="6dp"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="#00E5FF"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Suggestion section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1A10B981"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvOtpSuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:text="Scanning..."/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>